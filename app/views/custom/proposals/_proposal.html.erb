<%
  # 1. Set a flag based on the variable passed to the partial
  #    We default to 'false' (the side-by-side style)
  is_hero_layout = local_assigns.fetch(:layout_style, :default) == :hero
%>
<div id="<%= dom_id(proposal) %>"
     class="proposal clear <%= ("successful" if proposal.successful?) %>" data-type="proposal">
  <div class="panel with-image <%= 'panel--hero' if is_hero_layout %>">
    <% if proposal.successful? %>
      <div class="icon-successful"></div>
    <% end %>

    <div class="panel-image">
      <% if proposal.image.present? %>
        <% if is_hero_layout %>
          <%= image_tag proposal.image.variant(:feed_thumb),
                        alt: proposal.image.title.unicode_normalize %>
        <% else %>
          <%= image_tag proposal.image.variant(:medium),
                        alt: proposal.image.title.unicode_normalize %>
        <% end %>
      <% else %>
        <% if is_hero_layout %>
          <%= image_tag proposal.image.variant(:feed_thumb),
                        alt: proposal.image.title.unicode_normalize %>
        <% else %>
          <%= image_tag(image_path_for("proposal_background_no_image.png"), alt: proposal.title) %>
        <% end %>

      <% end %>
    </div>

    <%= render Shared::BasicContentComponent.new(proposal) do %>
      <%= render Shared::BasicInfoComponent.new(proposal) do %>
        <% if Geozone.any? %>
          <span class="bullet">&nbsp;&bull;&nbsp;</span>
          <span class="geozone">
            <%= link_to geozone_name(proposal), proposals_path(search: geozone_name(proposal)) %>
          </span>
        <% end %>
      <% end %>

      <h4><%= t("budgets.investments.show.estimated_price") %></h4>
      <p class="investment-project-amount">
        <%= proposal.price.nil? ? content_tag(:em, t("proposals.proposal.price_not_yet_known")) : proposal.formatted_price %>
      </p>
    <% end %>

    <% if show_proposal_votes? %>
      <div id="<%= dom_id(proposal) %>_votes" class="supports-container">
        <% if proposal.successful? %>
          <div class="padding">
            <div class="supports">
              <%= render "proposals/supports", proposal: proposal %>
            </div>
          </div>
        <% elsif proposal.archived? %>
          <div class="padding">
            <strong><%= t("proposals.proposal.supports", count: proposal.total_votes) %></strong>
            <p><%= t("proposals.proposal.archived") %></p>
          </div>
        <% else %>
          <%= render "votes", proposal: proposal %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
