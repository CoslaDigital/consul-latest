<% provide :title, t("map.title") %>

<%# Top Section: Universal Hero Headers %>
<%= render "shared/section_header", i18n_namespace: "proposals.index.section_header", image: "proposals" %>

<div class="row margin-top">
  <%# Main Dashboard Column (Left Side: Map & Core Action Form) %>
  <div class="small-12 medium-9 column">

    <div class="row">
      <div class="small-12 column">
        <h1><%= t("map.title") %></h1>
      </div>
    </div>

    <%# Full-Width Interactive Leaflet Map Instance %>
    <div class="row margin-bottom">
      <div class="small-12 column">
        <div class="budgets-map">
          <%= render Proposals::MapComponent.new(@proposals) %>
        </div>
      </div>
    </div>

    <%# Action Card: Target Neighborhood Filter Menu %>
    <div class="row card margin-bottom padding">
      <div class="small-12 column">
        <h2><%= t("map.proposal_for_district") %></h2>
        <p class="help-text"><%= t("proposals.form.geozone_help") %></p>

        <%= form_for(@proposal, url: new_proposal_path, method: :get, html: { class: "custom-form" }) do |f| %>
          <div class="row align-middle">
            <div class="small-12 medium-8 column">
              <%= f.select :geozone_id, geozone_select_options,
                           include_blank: t("geozones.none"),
                           label: false %>
            </div>
            <div class="small-12 medium-4 column text-right">
              <%= f.submit(class: "button radius expanded margin-none", value: t("map.start_proposal")) %>
            </div>
          </div>
        <% end %>
      </div>
    </div>

  </div>

  <<%# Utility Control Sidebar Column (Right Side: Call-to-Actions, Districts, & Tags) %>
  <div class="small-12 medium-3 column">
    <aside class="sidebar margin-bottom">
      <%= link_to t("map.start_proposal"),
                  new_proposal_path,
                  class: "button radius expand" %>

      <%# Section 1: Categories / Custom Side Filters %>
      <%= render "categories" %>

      <%# Section 2: Global Tag Cloud %>
      <%= render "shared/tag_cloud", taggable: "Proposal" %>

      <%# Section 3: Clean, Framework-Aligned Districts List %>
      <div class="sidebar-divider"></div>
      <h2 class="sidebar-title"><%= t("shared.tags_cloud.districts") %></h2>

      <ul class="categories-list no-bullet" style="margin: 0; padding: 0; list-style: none;">
        <% @geozones.each do |geozone| %>
          <li style="line-height: 2; margin: 0; padding: 0;">
            <%= link_to geozone.name,
                        proposals_path(search: geozone.name),
                        title: geozone.name %>
          </li>
        <% end %>
      </ul>

    </aside>
  </div>
</div>
