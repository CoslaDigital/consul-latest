<h2 class="inline-block"><%= t("admin.users.index.title") %></h2>

<%= link_to t("admin.users.index.create", default: "Create User"), new_admin_user_path, class: "button float-right" %>
<%= link_to t("admin.users.index.bulk_create", default: "Bulk Generate"), new_admin_users_generation_path, class: "button float-right hollow margin-right" %>

<div class="row margin-bottom">
  <div class="small-12 text-right">
    <%= link_to "Generation History", admin_users_generations_path, class: "button tiny clear" %>
    <%= link_to "Password Reset History", admin_users_bulk_password_resets_path, class: "button tiny clear" %>
  </div>
</div>

<%# Subheading aligned natively with the grid collapse container %>
<h3 class="margin-bottom-half"><%= t("admin.shared.search.label.users", default: "Find users") %></h3>

<%= form_tag admin_users_path, method: :get do %>
  <!-- 'collapse' removes Foundation's negative row margins so it aligns flush left -->
  <div class="row collapse margin-bottom">

    <div class="small-12 medium-5 columns" style="padding-right: 15px;">
      <!-- Using the exact translation key revealed in the hash dump -->
      <%= text_field_tag :search, params[:search], placeholder: t("admin.shared.search.label.users", default: "Search user by name or email"), style: "margin: 0;" %>
    </div>

    <div class="small-12 medium-4 columns" style="padding-right: 15px;">
      <%= select_tag :geozone_id, options_from_collection_for_select(Geozone.all.order(:name), :id, :name, params[:geozone_id]), prompt: "All Geozones", style: "margin: 0;" %>
    </div>

    <div class="small-12 medium-3 columns">
      <!-- Appending .search accesses just the string "Search" instead of the whole dictionary -->
      <%= submit_tag t("admin.shared.search.search", default: "Search"), class: "button expanded", style: "margin: 0;" %>
    </div>

  </div>
<% end %>

<div id="users">
  <%= render "users" %>
</div>
