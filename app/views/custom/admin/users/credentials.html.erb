<% provide :main_class, "admin-user-credentials" %>

<%# 1. Inject a print-only CSS block to hide the Admin layout wrappers %>
<style media="print">
  /* Hide the admin sidebar, top menu, and standard wrapper elements */
  header, footer, .topbar, #menu, .admin-sidebar, .menu {
    display: none !important;
  }

  /* Reset the main content width so it doesn't leave a blank space where the sidebar was */
  .off-canvas-content, .main-content, #content {
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
  }

  /* Use Foundation's standard print classes to toggle our specific content */
  .hide-for-print {
    display: none !important;
  }

  .show-for-print {
    display: block !important;
  }
</style>

<h2 class="hide-for-print"><%= t("admin.users.credentials.title", default: "User Credentials Generated") %></h2>

<%# 2. Hidden div that ONLY appears on the physical paper %>
<div class="show-for-print" style="display: none;">
  <h2><%= t("admin.users.credentials.print_header", default: "Account Credentials") %></h2>
  <br>
  <p style="font-size: 1.2rem;">
    <%= t("shared.username") %>: <strong><%= @user.username %></strong><br><br>
    <%= t("management.account.edit.password.password") %>: <strong><%= session[:new_password] %></strong>
  </p>
</div>

<%# 3. The UI the admin sees on the screen %>
<div class="row hide-for-print">
  <div class="columns small-12 medium-6">
    <p class="callout success">
      <%= t("management.account.edit.password.reseted", default: "Password has been successfully updated.") %>
    </p>

    <div class="callout">
      <p>
        <strong><%= t("shared.username") %>:</strong> <%= @user.username %><br>
        <strong><%= t("management.account.edit.password.password") %>:</strong>
        <code><%= session[:new_password] %></code>
      </p>
    </div>
  </div>
</div>

<div class="row margin-top hide-for-print">
  <div class="columns small-12">
    <%= link_to t("admin.shared.back"), admin_users_path, class: "button hollow" %>
    <a id="print_link" href="javascript:window.print();" class="button warning">
      <%= t("management.account.edit.password.print") %>
    </a>
  </div>
</div>

<%# Clear the session so it doesn't linger securely %>
<% session.delete(:new_password) %>
