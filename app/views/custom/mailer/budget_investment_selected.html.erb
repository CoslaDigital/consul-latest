<td style="<%= css_for_mailer_content %>">

  <h1 style="<%= css_for_mailer_heading %>">
    <%= t("mailers.budget_investment_selected.title") %>
  </h1>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.budget_investment_selected.hi", default: "Hello,") %>
  </p>

  <div style="<%= css_for_mailer_text + css_for_mailer_quote %>">
    <p style="<%= css_for_mailer_text %> margin-bottom: 5px;">
      <%= t("mailers.budget_investment_selected.project_title_label", default: "Project title:") %>
      <strong><%= @investment.title %></strong>
    </p>
    <p style="<%= css_for_mailer_text %> margin-top: 0;">
      <%= t("mailers.budget_investment_selected.price", default: "Assessed Price:") %>
      <strong><%= number_to_currency(@investment.price, precision: 0) %></strong>
    </p>
  </div>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.budget_investment_selected.share") %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= link_to t("mailers.budget_investment_selected.share_button"),
                budget_investment_url(@investment.budget, @investment, anchor: "social-share"),
                style: css_for_mailer_link %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.budget_investment_selected.thanks") %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.budget_investment_selected.sincerely") %>
  </p>
</td>
