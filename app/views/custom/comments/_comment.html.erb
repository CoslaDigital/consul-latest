<% valuation = local_assigns.fetch(:valuation, false) %>
<% is_author = current_user.present? && current_user.id == comment.user_id %>

<%# MAGIC FIX: Render if visible, OR if hidden with replies, OR if the current user is the author %>
<% unless (comment.hidden? || comment.user.hidden?) && comment.children.blank? && !is_author %>

  <%# cache [locale_and_user_status(comment), can?(:admin, :all), comment, commentable_cache_key(comment.commentable), comment.author] do %>
  <div id="<%= dom_id(comment) %>" class="comment small-12">
    <div class="comment-body">

      <% if (comment.hidden? || comment.user.hidden?) && is_author %>

        <%# ROUTE A: The Author's view of their own hidden comment %>
        <%= render Comments::AvatarComponent.new(comment) %>
        <%= render Comments::InfoComponent.new(comment, valuation: valuation, user_viewer: current_user) %>

        <div class="callout warning" style="background-color: #fff3cd; border-color: #ffeeba; color: #856404; padding: 1rem; margin-top: 1rem; margin-bottom: 1rem; border-radius: 4px;">
          <strong>⚠️ Your comment was hidden by our automated moderation system.</strong><br>
          <small>It was flagged for violating our community guidelines and is currently invisible to other users while
            awaiting human review.</small>

          <div style="margin-top: 10px; opacity: 0.7;">
            <%= simple_format sanitize_and_auto_link(comment.body), {}, sanitize: false %>
          </div>
        </div>

        <%= render Comments::StatusBarComponent.new(comment, valuation: valuation) %>

      <% elsif comment.hidden? || comment.user.hidden? %>

        <%# If not the author, but the hidden comment has replies, show standard placeholder %>
        <div class="callout secondary">
          <p><%= t("comments.comment.deleted") %></p>
        </div>

      <% else %>

        <%# Normal, clean comment rendering for everyone else %>
        <%= render Comments::AvatarComponent.new(comment) %>
        <%= render Comments::InfoComponent.new(comment, valuation: valuation, user_viewer: current_user) %>

        <div class="comment-user <%= user_level_class comment %> <%= comment_author_class comment, comment.commentable.author_id %>">
          <%= simple_format sanitize_and_auto_link(comment.body), {}, sanitize: false %>
        </div>

        <%= render Comments::StatusBarComponent.new(comment, valuation: valuation) %>
      <% end %>
    </div>

    <%= render "comments/comment_list", comments: child_comments_of(comment), valuation: valuation %>
  </div>
  <%# end %>

<% end %>
