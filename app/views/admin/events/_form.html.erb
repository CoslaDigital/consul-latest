<%= form_with model: [:admin, @event], builder: ConsulFormBuilder, local: true do |f| %>

  <%= render "shared/errors", resource: @event %>

  <div class="row">
    <div class="small-12 medium-6 column">
      <%= f.datetime_field :starts_at, class: "input-group-field" %>
    </div>

    <div class="small-12 medium-6 column">
      <%= f.datetime_field :ends_at, class: "input-group-field" %>
    </div>
  </div>

  <div class="row">
    <div class="small-12 column">
      <%= f.text_field :name %>
    </div>
  </div>

  <div class="row">
    <div class="small-12 column">
      <%= f.text_area :description, rows: 8, class: "html-area" %>
    </div>
  </div>

  <div class="row">
    <div class="small-12 medium-6 column">
      <%# The label is handled by the builder; the options are translated here %>
      <%= f.select :event_type,
                   Event::TYPES.map { |type| [I18n.t("events.event_types.#{type}"), type] },
                   include_blank: t('events.prompts.select_type') %>
    </div>

    <div class="small-12 medium-6 column">
      <%= f.text_field :location %>
    </div>
  </div>
  <% if feature?(:map) %>
    <div class="small-12 column margin-top">
      <%= f.fields_for :map_location, (@event.map_location || @event.build_map_location) do |map_form| %>
        <label><%= t("proposals.form.map_location", default: "Map location") %></label>
        <p class="help-text">
          <%= t("proposals.form.map_location_instructions", default: "Navigate the map to the location and place the marker.") %>
        </p>

        <%= render Shared::MapLocationComponent.new(map_form.object, form: map_form) %>

        <%= map_form.hidden_field :latitude %>
        <%= map_form.hidden_field :longitude %>
        <%= map_form.hidden_field :zoom %>
      <% end %>
    </div>
  <% end %>

  <% if feature?(:allow_attached_documents) %>
    <%= render Documents::NestedComponent.new(f) %>
  <% end %>

  <%# SUBMIT BUTTON ROW %>
  <div class="row">
    <div class="small-12 medium-6 column end">
      <%= f.submit t("events.#{action_name}.submit_button", default: t("events.submit.default")),
                   class: "button success" %>
    </div>
  </div>

<% end %>
