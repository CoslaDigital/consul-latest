<% provide :title do %>
  <%= t("admin.header.title") %> - <%= t("admin.menu.legislation") %> - Create from Propositions
<% end %>

<div class="legislation-propositions-import-new">
  <%= back_link_to admin_legislation_processes_path, "Back to legislative processes" %>

  <h2>Create Consultation from Jigsaw Propositions</h2>

  <%= form_for [:admin, @import], url: admin_legislation_propositions_imports_path do |f| %>
    <%= render "shared/errors", resource: @import %>

    <div class="row">
      <div class="small-12 medium-8 column">
        <div class="callout primary margin-top margin-bottom">
          <h5>💡 Pipeline Instructions</h5>
          <p>
            Upload the compiled <code>final_ranked_propositions.csv</code> file generated by your pipeline.
            The system will automatically harvest the topics and parse the policy propositions into an un-published
            <strong>Draft Phase</strong> consultation.
          </p>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="small-12 medium-6 column margin-top">
        <%= f.label :file, "Upload Propositions CSV File" %>
        <%= f.file_field :file, accept: '.csv' %>
      </div>
    </div>

    <div class="row">
      <div class="small-12 medium-4 large-2 column margin-top">
        <%= f.submit class: "button success expanded", value: t("shared.save") %>
      </div>
    </div>
  <% end %>
</div>
