<%# app/views/my_area/show.html.erb %>
<main class="wrapper">
  <div class="row">
    <div class="small-12 column">
      <div class="margin-top">
        <h1 class="text-center">
          <%= t(".title", authority: @local_authority_name) %>
        </h1>
        <p class="text-center lead">
          <%= t(".lead") %>
        </p>
      </div>
    </div>
  </div>

  <%# --- ACTIVE VOTING SECTION --- %>
  <% if @active_voting.any? %>
    <div class="row margin-top">
      <div class="small-12 column">
        <h2 class="section-title"><%= t(".sections.active_voting") %></h2>
        <div class="row small-up-1 medium-up-2 large-up-3">
          <% @active_voting.each do |budget| %>
            <div class="column">
              <div class="card margin-bottom">
                <div class="card-content">
                  <h3><%= link_to budget.name, budget_path(budget) %></h3>
                  <p>
                    <strong><%= t(".cards.phase_label") %></strong>
                    <%= t(".cards.open_now") %>
                  </p>
                  <%= link_to t(".cards.cast_vote"), budget_path(budget), class: "button expanded success" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# --- UPCOMING PROCESSES SECTION --- %>
  <% if @upcoming.any? %>
    <div class="row margin-top">
      <div class="small-12 column">
        <h2 class="section-title"><%= t(".sections.upcoming") %></h2>
        <div class="row small-up-1 medium-up-2 large-up-3">
          <% @upcoming.each do |budget| %>
            <div class="column">
              <div class="card margin-bottom">
                <div class="card-content">
                  <h3><%= link_to budget.name, budget_path(budget) %></h3>
                  <p>
                    <strong><%= t(".cards.phase_label") %></strong>
                    <%= t("budgets.phase.#{budget.phase}") %>
                  </p>
                  <%= link_to t(".cards.view_details"), budget_path(budget), class: "button expanded hollow" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# --- PAST RESULTS SECTION --- %>
  <% if @past_results.any? %>
    <div class="row margin-top margin-bottom">
      <div class="small-12 column">
        <h2 class="section-title"><%= t(".sections.past_results") %></h2>
        <div class="row small-up-1 medium-up-2 large-up-3">
          <% @past_results.each do |budget| %>
            <div class="column">
              <div class="card margin-bottom">
                <div class="card-content">
                  <h3><%= link_to budget.name, budget_path(budget) %></h3>
                  <p>
                    <strong><%= t(".cards.status_label") %></strong>
                    <%= t(".cards.finished") %>
                  </p>
                  <%= link_to t(".cards.view_results"), budget_results_path(budget), class: "button expanded hollow secondary" %>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <%# --- EMPTY STATE FALLBACK --- %>
  <% if @active_voting.empty? && @upcoming.empty? && @past_results.empty? %>
    <div class="row margin-top margin-bottom">
      <div class="small-12 column text-center">
        <div class="callout primary">
          <h3><%= t(".empty_state.title") %></h3>
          <p><%= t(".empty_state.description", authority: @local_authority_name) %></p>
        </div>
      </div>
    </div>
  <% end %>
</main>
