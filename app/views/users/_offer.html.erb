<tr id="offer_<%= offer.id %>">
  <td>
    <%= link_to offer.title, offer_path(offer) %>
  </td>

  <td>
    <%# Using the 'label' class gives it a nice badge look.
        You can translate the statuses in your en.yml file under offers.status %>
    <span class="label hollow">
      <%= t("offers.status.#{offer.status}", default: offer.status.to_s.titleize) %>
    </span>
  </td>

  <td>
    <%= render Offers::TableActionsComponent.new(offer) %>
  </td>
</tr>
