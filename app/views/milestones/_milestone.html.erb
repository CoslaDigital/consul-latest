<li>
  <div class="milestone-content">

    <% if milestone.publication_date.present? %>
      <span class="milestone-date">
        <strong>
          <%= t("milestones.show.publication_date",
                publication_date: l(milestone.publication_date.to_date)) %>
        </strong>
      </span>
    <% end %>

    <% if milestone.status.present? %>
      <p>
        <strong>
          <%= t("milestones.show.status_changed") %>
        </strong>
        <br>
        <span class="milestone-status">
          <%= milestone.status.name %>
        </span>
      </p>
    <% end %>

    <%= image_tag(milestone.image.variant(:large), { id: "image_#{milestone.id}", alt: milestone.image.title, class: "margin" }) if milestone.image.present? %>

    <p>
      <%= sanitize_and_auto_link milestone.description %>
    </p>

    <% if milestone.documents.present? %>
      <div class="documents">
        <div class="document-link text-left small">
          <p>
            <strong><%= t("shared.documentation") %></strong>
          </p>

          <% milestone.documents.each do |document| %>
            <%= render Documents::DocumentComponent.new(document) %>
          <% end %>
        </div>
      </div>
    <% end %>
    <div class="milestone-actions margin-top">
      <% if can? :update, milestone %>
        <%
          parent = milestone.milestoneable

          # Explicitly define paths only for user-managed resources.
          # Legislation is purposely omitted because it has no public edit route.
          path = case parent
                 when Budget::Investment
                   edit_budget_investment_milestone_path(parent.budget_id, parent.id, milestone)
                 when Proposal
                   edit_proposal_milestone_path(parent, milestone)
                 else
                   nil
                 end
        %>

        <% if path.present? %>
          <%= link_to t("milestones.milestone.edit_button", default: "Edit Milestone"),
                      path,
                      class: "button tiny" %>
        <% end %>
      <% end %>
    </div>
  </div>
</li>
