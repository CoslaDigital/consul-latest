<%# app/views/budgets/results/stv_report_pdf.html.erb %>
<%#
  This template is intentionally minimal. It renders the same ViewComponents
  used by the HTML reports, so the PDF and HTML versions cannot drift apart.
%>

<div class="stv-summary-section">
  <%= render StvSummaryReportComponent.new(
    result: @result,
    budget: @budget,
    heading: @heading,
    candidates: @candidates,
    votes_cast: @votes_cast,
    quota: @quota,
    report_title: "Election Results: #{@budget.name}",
    dynamic_quota_enabled: @budget.respond_to?(:stv_dynamic_quota?) && @budget.stv_dynamic_quota?
  ) %>
</div>

<div style="page-break-before: always;"></div>

<div class="stv-detail-section">
  <%= render StvDetailReportComponent.new(
    rounds: @result.rounds,
    investment_titles: @investment_titles,
    dynamic_quota_enabled: @budget.respond_to?(:stv_dynamic_quota?) && @budget.stv_dynamic_quota?,
    heading: @heading
  ) %>
</div>
