<td style="<%= css_for_mailer_content %>">
  <h1 style="<%= css_for_mailer_heading %>">
    <%= t("mailers.proposal_match_accepted.title") %>
  </h1>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.proposal_match_accepted.hi", name: @recipient.name) %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= sanitize(t("mailers.proposal_match_accepted.text", provider: "<strong>#{@match.offer.author.name}</strong>", proposal: "<strong>#{@match.proposal.title}</strong>", offer: "<strong>#{@match.offer.title}</strong>")) %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.proposal_match_accepted.instruction") %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= link_to t("mailers.proposal_match_accepted.go_to_dashboard"), mine_offers_url, style: css_for_mailer_link %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.proposal_match_accepted.sincerely") %>
  </p>
</td>
