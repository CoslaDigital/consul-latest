<td style="<%= css_for_mailer_content %>">
  <h1 style="<%= css_for_mailer_heading %>">
    <%= t("mailers.proposal_match_confirmed.title") %>
  </h1>

  <%# We keep this just in case they want a greeting, but they can leave the translation blank in the admin panel if they don't want it %>
  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.proposal_match_confirmed.hi", name: @recipient.name) %>
  </p>

  <%# 1. Main Text %>
  <p style="<%= css_for_mailer_text %>">
    <%= sanitize(t("mailers.proposal_match_confirmed.text", proposal: "<strong>#{@match.proposal.title}</strong>", offer: "<strong>#{@match.offer.title}</strong>")) %>
  </p>

  <%# 2. NEW: Community Steps Block %>
  <div style="<%= css_for_mailer_text %>">
    <p style="margin-bottom: 5px;">
      <strong><%= t("mailers.proposal_match_confirmed.community_steps_title", default: "Final steps for the community groups") %></strong>
    </p>
    <div style="margin-top: 0; margin-bottom: 15px;">
      <%= simple_format(t("mailers.proposal_match_confirmed.community_steps_text")) %>
    </div>
  </div>

  <%# 3. NEW: Business Steps Block %>
  <div style="<%= css_for_mailer_text %>">
    <p style="margin-bottom: 5px;">
      <strong><%= t("mailers.proposal_match_confirmed.business_steps_title", default: "Final Step for the business") %></strong>
    </p>
    <div style="margin-top: 0; margin-bottom: 15px;">
      <%= simple_format(t("mailers.proposal_match_confirmed.business_steps_text")) %>
    </div>
  </div>

  <p style="<%= css_for_mailer_text %>">
    <%= link_to t("mailers.proposal_match_confirmed.view_dashboard"), mine_offers_url, style: css_for_mailer_link %>
  </p>
</td>
