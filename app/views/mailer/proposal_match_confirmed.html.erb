<td style="<%= css_for_mailer_content %>">
  <h1 style="<%= css_for_mailer_heading %>">
    <%= t("mailers.proposal_match_confirmed.title") %>
  </h1>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.proposal_match_confirmed.hi", name: @recipient.name) %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= sanitize(t("mailers.proposal_match_confirmed.text", proposal: "<strong>#{@match.proposal.title}</strong>", offer: "<strong>#{@match.offer.title}</strong>")) %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.proposal_match_confirmed.next_steps") %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= link_to t("mailers.proposal_match_confirmed.view_dashboard"), mine_offers_url, style: css_for_mailer_link %>
  </p>
</td>
