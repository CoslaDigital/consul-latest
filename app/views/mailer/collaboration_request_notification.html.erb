<td style="<%= css_for_mailer_content %>">
  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.collaboration_request.hi", name: @provider.name) %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.collaboration_request.main_text",
          requester_name: @requester.name,
          proposal_title: @proposal.title) %>:
  </p>

  <%# The Resource/Offer being requested - updated to use standard CONSUL quote CSS %>
  <div style="<%= css_for_mailer_text + css_for_mailer_quote %>">
    <strong><%= @offer.title %></strong>
  </div>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.collaboration_request.action_text") %>
  </p>

  <%# Replaced hardcoded blue button with standard CONSUL mailer link %>
  <p style="<%= css_for_mailer_text %>">
    <%= link_to t("mailers.collaboration_request.button"), mine_offers_url, style: css_for_mailer_link %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.collaboration_request.footer_text") %>
  </p>
</td>
