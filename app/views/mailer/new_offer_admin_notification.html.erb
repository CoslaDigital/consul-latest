<td style="<%= css_for_mailer_content %>">
  <h1 style="<%= css_for_mailer_heading %>">
    <%= t("mailers.new_offer_admin_notification.subject") %>
  </h1>

  <p style="<%= css_for_mailer_text %>">
    A new offer has been published on the Mutual Aid platform.
  </p>

  <p style="<%= css_for_mailer_text %>">
    <strong>Author:</strong> <%= @offer.author.name %><br>
    <strong>Title:</strong> <%= @offer.title %><br>
    <strong>Description:</strong> <%= @offer.description %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <%= link_to "Review in Admin Dashboard", admin_collaborations_url, style: css_for_mailer_link %>
  </p>
</td>
