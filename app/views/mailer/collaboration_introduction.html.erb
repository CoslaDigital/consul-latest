<td style="<%= css_for_mailer_content %>">
  <h1 style="<%= css_for_mailer_heading %>">
    <%= t("mailers.collaboration_introduction.title") %>
  </h1>

  <p style="<%= css_for_mailer_text %>">
    <%= sanitize(t("mailers.collaboration_introduction.intro", other_name: "<strong>#{@other_party.name}</strong>", proposal_title: "<strong>#{@proposal.title}</strong>")) %>
  </p>

  <div style="<%= css_for_mailer_text + css_for_mailer_quote %>">
    <p style="<%= css_for_mailer_text %>">
      <strong><%= t("mailers.collaboration_introduction.contact_details") %></strong>
    </p>
    <p style="<%= css_for_mailer_text %>">
      <%= @other_party.name %>: <%= mail_to @other_party.email, @other_party.email, style: css_for_mailer_link %>
    </p>
  </div>

  <p style="<%= css_for_mailer_text %>">
    <strong><%= t("mailers.collaboration_introduction.summary_title") %></strong>
  </p>
  <ul>
    <li style="<%= css_for_mailer_text %>"><strong>Resource:</strong> <%= @offer.title %></li>
    <li style="<%= css_for_mailer_text %>"><strong>Proposal:</strong> <%= @proposal.title %></li>
  </ul>

  <p style="<%= css_for_mailer_text %>">
    <%= t("mailers.collaboration_introduction.next_steps") %>
  </p>
</td>
