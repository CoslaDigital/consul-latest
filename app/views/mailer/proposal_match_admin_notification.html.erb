<td style="<%= css_for_mailer_content %>">

  <h1 style="<%= css_for_mailer_heading %>">
    Mutual Aid Activity Detected
  </h1>

  <p style="<%= css_for_mailer_text %>">
    A collaboration between <strong><%= @match.offer.author.name %></strong> and
    <strong><%= @match.proposal.author.name %></strong> has been <strong><%= @action_type %></strong>.
  </p>

  <p style="<%= css_for_mailer_text %>">
    <strong>Proposal:</strong> <%= @match.proposal.title %><br>
    <strong>Offer:</strong> <%= @match.offer.title %>
  </p>

  <table style="width: 100%;">
    <tbody>
    <tr>
      <td style="padding-bottom: 12px; text-align: center;">
        <%= link_to admin_collaborations_url, style: css_for_mailer_button do %>
          Manage Collaborations
        <% end %>
      </td>
    </tr>
    </tbody>
  </table>

</td>
