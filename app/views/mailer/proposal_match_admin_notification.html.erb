<td style="<%= css_for_mailer_content %>">

  <h1 style="<%= css_for_mailer_heading %>">
    <%= t("mailers.proposal_match_admin_notification.title") %>
  </h1>

  <p style="<%= css_for_mailer_text %>">
    <%= sanitize(t("mailers.proposal_match_admin_notification.text",
                   provider: @match.offer.author.name,
                   requester: @match.proposal.author.name,
                   action_type: @action_type)) %>
  </p>

  <p style="<%= css_for_mailer_text %>">
    <strong><%= t("mailers.proposal_match_admin_notification.proposal_label") %></strong> <%= @match.proposal.title %>
    <br>
    <strong><%= t("mailers.proposal_match_admin_notification.offer_label") %></strong> <%= @match.offer.title %>
  </p>

  <table style="width: 100%;">
    <tbody>
    <tr>
      <td style="padding-bottom: 12px; text-align: center;">
        <%= link_to admin_collaborations_url, style: css_for_mailer_button do %>
          <%= t("mailers.proposal_match_admin_notification.button") %>
        <% end %>
      </td>
    </tr>
    </tbody>
  </table>

</td>
