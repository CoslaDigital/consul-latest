<% provide :title, t("offers.index.title", default: "Community Offers") %>
<% content_for :header_addon do %>
  <%= render "shared/search_form",
             search_path: offers_path(page: 1),
             i18n_namespace: "offers.index.search_form" %>
<% end %>
<% content_for :canonical do %>
  <%= render "shared/canonical", href: offers_url %>
<% end %>

<%= render "shared/section_header", i18n_namespace: "offers.index.section_header", image: "proposals" %>

<div class="row">
  <div id="offers" class="offers-list small-12 medium-9 column">

    <%= render Shared::BannerComponent.new("offers") %>



    <%= render "shared/order_links", i18n_namespace: "offers.index" %>

    <% if @offers.any? %>
      <div class="show-for-small-only">
        <%= link_to t("offers.index.start_offer", default: "Create an Offer"),
                    new_offer_path,
                    class: "button expanded" %>
      </div>
    <% end %>

    <div id="offers-list">
      <% if @offers.any? || current_user.blank? %>
        <% @offers.each do |offer| %>
          <%= render "offers/offer", offer: offer %>
        <% end %>
      <% else %>
        <div class="callout primary">
          <%= t("offers.index.empty", default: "There are no active offers at the moment. Be the first to offer help!") %>
        </div>
      <% end %>
      <%= paginate @offers %>
    </div>
  </div>

  <div class="small-12 medium-3 column">
    <aside class="margin-bottom">
      <%= link_to t("offers.index.start_offer", default: "Create an Offer"),
                  new_offer_path,
                  class: "button expanded" %>

      <div class="sidebar-divider"></div>

      <%= render "shared/tag_cloud", taggable: "Offer" %>

      <div class="sidebar-divider"></div>
      <div class="offers-geozones">
        <h2 class="sidebar-title"><%= t("shared.tags_cloud.districts_list") %></h2>
        <br>
        <ul id="geozones" class="no-bullet">
          <% Geozone.all.each do |geozone| %>
            <li><%= link_to geozone.name, offers_path(search: geozone.name) %></li>
          <% end %>
        </ul>
      </div>
    </aside>
  </div>
</div>
