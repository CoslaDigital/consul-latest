<% if matches.any? %>
  <table class="matches-table table-fixed margin-top">
    <thead>
    <tr>
      <th width="20%"><%= t("offers.mine.column.provider") %></th>
      <th width="35%"><%= t("offers.mine.column.resource") %></th>
      <th width="20%"><%= t("offers.mine.column.project") %></th>
      <th width="25%" class="text-right"><%= t("offers.mine.column.status") %></th>
    </tr>
    </thead>
    <tbody>
    <% matches.each do |match| %>
      <tr id="<%= dom_id(match) %>" class="match-row">

        <%# 1. Provider Name %>
        <td class="vertical-top">
          <i class="fa fa-user-circle text-muted"></i>
          <strong><%= match.offer.author.name %></strong>
        </td>

        <%# 2. Resource/Offer Link %>
        <td class="vertical-top">
          <%= link_to match.offer.title, match.offer, class: "bold" %>
        </td>

        <%# 3. Linked Project %>
        <td class="vertical-top">
          <%= link_to match.proposal.title, match.proposal, class: "text-muted small" %>
        </td>

        <%# 4. Status and Collaboration Actions %>
        <td class="text-right vertical-top">
          <%# The Badge (Only one instance now) %>
          <span class="label <%= status_label_class(match.status) %> margin-bottom-s display-inline-block">
            <%= t("proposal_matches.status.#{match.status}", default: match.status.titleize) %>
          </span>

          <div class="action-buttons">
            <% if match.accepted? %>
              <%= button_to confirm_proposal_match_path(match),
                            method: :patch,
                            class: "button success tiny expanded no-margin" do %>
                <i class="fa fa-handshake-o"></i> <%= t("proposals.show.confirm_button") %>
              <% end %>
            <% elsif match.confirmed? %>
              <%= button_to fulfill_proposal_match_path(match),
                            method: :patch,
                            class: "button success hollow tiny expanded no-margin",
                            data: { confirm: t("proposals.show.confirm_fulfillment_check") } do %>
                <i class="fa fa-check-circle"></i> <%= t("proposals.show.fulfill_button") %>
              <% end %>
            <% end %>
          </div>
        </td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% else %>
  <div class="callout primary">
    <p><%= t("offers.mine.no_inbound") %></p>
  </div>
<% end %>
