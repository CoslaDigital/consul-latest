<%# app/components/stv_summary_report_component.html.erb %>

<%# ------------------------------------------------------------------
    Heading (the CMS page title is rendered above this by the chrome)
    ------------------------------------------------------------------ %>
<h1><%= @heading.name %></h1>
<hr>

<%# ------------------------------------------------------------------
    Election Summary
    ------------------------------------------------------------------ %>
<h3>🗳️ Election Summary</h3>
<ul>
  <li><strong>Seats to fill:</strong> <%= total_seats %></li>
  <li><strong>Total Candidates:</strong> <%= @candidates.count %></li>
  <li><strong>Valid Ballots Counted:</strong> <%= @votes_cast %></li>
  <li><strong>Non-Transferable (Exhausted) Votes:</strong> <%= format_votes(@result.exhausted_total) %></li>
</ul>

<%# ------------------------------------------------------------------
    Candidates
    ------------------------------------------------------------------ %>
<h3>👥 Candidates</h3>
<p>The following <%= @candidates.count %> candidate(s) contested this election:</p>
<ol style="column-count: 2; column-gap: 20px;">
  <% sorted_candidate_titles.each do |title| %>
    <li><%= title %></li>
  <% end %>
</ol>

<%# ------------------------------------------------------------------
    About the Quota
    ------------------------------------------------------------------ %>
<h3>🎯 About the Quota</h3>

<% if @dynamic_quota_enabled %>
  <div style="padding: 10px; margin-bottom: 1em; background-color: #eef; border: 1px solid #aac;">
    <strong>Notice:</strong> Dynamic Quota Recalculation is enabled. The initial quota is shown below;
    it is recalculated each round in the detailed count.
  </div>
<% end %>

<p>
  The quota is the minimum number of votes required for a candidate to be guaranteed election.
  Once a candidate reaches it, they are elected.
</p>
<p>
  This election uses the <strong>Droop Quota</strong>, as defined in Rule 47 of the
  Scottish Local Government Elections Order 2011:
</p>
<pre style="background-color:#f0f0f0; padding: 10px; border-radius: 5px; margin: 10px 0; font-family: monospace; white-space: pre-wrap;">Quota = ⌊Total Valid Votes ÷ (Seats + 1)⌋ + 1
Quota = ⌊<%= @votes_cast %> ÷ (<%= total_seats %> + 1)⌋ + 1 = <strong><%= @quota %></strong></pre>

<%# ------------------------------------------------------------------
    Link to detailed report
    ------------------------------------------------------------------ %>
<% if @detail_page_slug.present? %>
  <hr>
  <p style="text-align: center; font-size: 1.1em;">
    <a href="/<%= @detail_page_slug %>">➡️ View the round-by-round count for <%= @heading.name %></a>
  </p>
<% end %>
<hr>

<%# ------------------------------------------------------------------
    Final Results
    ------------------------------------------------------------------ %>
<h2>✅ Final Results</h2>

<% if @result.winners.any? %>
  <p>The following <%= @result.winners.size %> candidate(s) have been elected:</p>
  <ol>
    <% @result.winners.each do |winner_id| %>
      <% winner = candidate_for(winner_id) %>
      <li>
        <strong><%= winner&.title || "Unknown Candidate" %></strong>
        — <%= winner_description(winner_id) %>
      </li>
    <% end %>
  </ol>
<% else %>
  <p>No candidates were elected in this process.</p>
<% end %>

<%# ------------------------------------------------------------------
    Order of Elimination
    ------------------------------------------------------------------ %>
<% if @result.elimination_log.any? %>
  <h3>📊 Order of Elimination</h3>
  <table>
    <thead>
    <tr>
      <th>Round</th>
      <th>Candidate Eliminated</th>
      <th>Votes at Elimination</th>
    </tr>
    </thead>
    <tbody>
    <% @result.elimination_log.each do |log_entry| %>
      <tr>
        <td><%= log_entry[:round] %></td>
        <td><%= log_entry[:title] %></td>
        <td><%= format_votes(log_entry[:votes]) %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
<% end %>

<%# ------------------------------------------------------------------
    Rule 53 note (auto-election) — shown only when relevant
    ------------------------------------------------------------------ %>
<% if any_auto_elected? %>
  <p>
    <em>
      <strong>Note:</strong> Following the eliminations above, the number of continuing
      candidates equalled the number of remaining vacancies. Under Rule 53 of the
      Scottish Local Government Elections Order 2011, those candidates are deemed
      elected without the need for further transfers.
    </em>
  </p>
<% end %>

<%# ------------------------------------------------------------------
    Unfilled seats notice
    ------------------------------------------------------------------ %>
<% if @result.unfilled_seats > 0 %>
  <p>
    <strong>Notice:</strong> <%= @result.unfilled_seats %> seat(s) could not be filled because
    the number of continuing candidates fell below the number of remaining vacancies.
  </p>
<% end %>
