<%= form_with(model: offer, url: url, local: true, class: "offer-form") do |f| %>
  <%= render "shared/errors", resource: offer %>

  <fieldset class="required-fields">
    <legend><%= t("shared.required") %></legend>

    <div class="margin-bottom">
      <%= f.label :status, t("offers.form.status_label", default: "Availability Status") %>
      <%= f.select :status, Offer.statuses.keys.map { |s| [s.titleize, s] }, {}, class: "full-width" %>
      <p class="help-text">
        <%= t("offers.form.status_help", default: "Set to 'Pending' or 'Claimed' if you want to temporarily or permanently stop receiving new requests.") %>
      </p>
    </div>

    <div class="margin-bottom">
      <%= f.label :title, t("offers.form.title_note", default: "What resource are you providing?") %>
      <%= f.text_field :title, maxlength: 150 %>
    </div>

    <div class="margin-bottom">
      <%= f.label :description, t("offers.form.description_note", default: "Explain the details, limitations, and availability of your offer.") %>
      <%= f.text_area :description, rows: 6, maxlength: 5000, class: "html-area" %>
    </div>
  </fieldset>

  <fieldset>
    <legend><%= t("shared.optional") %></legend>

    <% if feature?(:allow_images) %>
      <%= render Images::NestedComponent.new(f) %>
    <% end %>

    <% if Geozone.any? %>
      <div>
        <%= f.select :geozone_id, geozone_select_options,
                     label: t("offers.form.geozone", default: "District / Neighborhood"),
                     hint: t("offers.form.geozone_help", default: "Where is this resource available? Leave blank if city-wide or remote."),
                     include_blank: t("geozones.none") %>
      </div>
    <% end %>

    <%#= render MapLocations::FormFieldsComponent.new(f, map_location: map_location) %>

    <div>
      <%= f.label :tag_list, t("offers.form.tags_label", default: "Tags") %>
      <p class="help-text" id="tag-list-help-text"><%= t("offers.form.tags_instructions", default: "Tags help match your offer to relevant proposals.") %></p>

      <div id="category_tags" class="tags">
        <%= f.label :category_tag_list, t("proposals.form.tag_category_label", default: "Categories") %>
        <% categories.each do |tag| %>
          <a class="js-add-tag-link"><%= tag.name %></a>
        <% end %>
      </div>

      <br>
      <%= f.text_field :tag_list, value: offer.tag_list.to_s,
                       label: false,
                       placeholder: t("offers.form.tags_placeholder", default: "e.g., Environment, Legal, Labor"),
                       class: "js-tag-list tag-autocomplete",
                       aria: { describedby: "tag-list-help-text" },
                       data: { js_url: suggest_tags_path } %>
    </div>
  </fieldset>

  <div class="actions">
    <% if offer.new_record? %>
      <div>
        <%= render Shared::AgreeWithTermsOfServiceFieldComponent.new(f) %>
      </div>
    <% end %>

    <%= f.submit(class: "button primary", value: t("offers.#{action_name}.form.submit_button", default: "Publish Offer")) %>
  </div>
<% end %>
