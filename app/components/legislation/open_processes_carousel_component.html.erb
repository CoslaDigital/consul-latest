<section id="feed_processes" class="widget-feed feed-processes">
  <header>
    <h2 class="title"><%= t("welcome.open_processes.title", default: "Open Legislation Processes") %></h2>
  </header>

  <p style="margin-bottom: 1rem;"><%= t("welcome.open_processes.help", default: "Participate in drafting and improving current legislation.") %></p>

  <div class="feed-content">
    <%# Changed data-timer-delay from 4000 to 7000 (7 seconds) %>
    <div class="orbit" role="region" data-orbit data-use-m-u-i="false" data-timer-delay="7000">

      <div class="orbit-wrapper">
        <ul class="orbit-container no-bullet" tabindex="0">
          <% processes.each_with_index do |process, index| %>

            <%# Removed the inline style="display: none;" so Foundation can animate smoothly %>
            <li class="orbit-slide <%= is_active_class(index) %>"
                data-slide="<%= index %>"
                aria-live="polite">

              <%= render Widget::Feeds::ProcessComponent.new(process) %>

            </li>

          <% end %>
        </ul>
        <div class="truncate"></div>
      </div>

      <div class="orbit-bullets">
        <% processes.each_with_index do |process, index| %>
          <button class="<%= is_active_class(index) %>"
                  title="<%= process.title %>"
                  data-slide="<%= index %>">
            <span class="show-for-sr">
              <%= process.title %>
            </span>
          </button>
        <% end %>
      </div>

    </div>
  </div>

  <%= link_to t("welcome.feed.see_all.processes"), legislation_processes_path, class: "see-all" %>
</section>
