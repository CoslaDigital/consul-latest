<%# app/components/stv_detail_report_component.html.erb %>
<h1>Detailed Election Log</h1>
<hr>

<% @rounds.each do |round| %>
  <br><h2>Round <%= round[:iteration] || round[:number] %>:</h2>
  <p>Quota to be elected: <%= round[:quota] %></p>

  <p><strong>Current Standings:</strong></p>
  <table>
    <thead><tr><th>Candidate</th><th>Votes</th></tr></thead>
    <tbody>
    <% round[:standings].each do |id, count| %>
      <tr>
        <td><%= @investment_titles[id] || "Unknown" %> (<%= id %>)</td>
        <td><%= count.to_f.round(2) %></td>
      </tr>
    <% end %>
    </tbody>
  </table>
  <br>

  <% if round[:action].is_a?(Hash) %>
    <% if round[:action][:type] == :election %>
      <strong>Action: Candidate Elected</strong>
      <p style="margin-left: 20px;">
        ✅ <strong>Elected: <%= round[:action][:title] %> (<%= round[:action][:candidate_id] %>)</strong>
        with <%= round[:action][:count].to_f.round(2) %> votes.
      </p>
    <% elsif round[:action][:type] == :elimination %>
      <strong>Action: Candidate Eliminated</strong>
      <p style="margin-left: 20px;">
        ❌ <strong>Eliminated: <%= round[:action][:title] %> (<%= round[:action][:candidate_id] %>)</strong>
        with <%= round[:action][:count].to_f.round(2) %> votes.
      </p>
    <% elsif round[:action][:type] == :auto_election %>
      <strong>Action: Candidate Auto-Elected</strong>
      <p style="margin-left: 20px;">
        ✅ <strong>Elected: <%= round[:action][:title] %> (<%= round[:action][:candidate_id] %>)</strong>
        (Automatically elected to fill remaining seat)
      </p>
    <% end %>
  <% else %>
    <p><strong><%= round[:action] %></strong></p>
  <% end %>
  <hr>
<% end %>
