<% if @proposal.proposal_matches.fulfilled.any? %>
  <div class="collaboration-history margin-bottom">
    <%# Changed from sidebar-title to standard bold %>
    <p class="margin-bottom-s">
      <i class="fa fa-certificate text-success" aria-hidden="true"></i>
      <strong><%= t("proposals.show.fulfilled_collabs") %></strong>
    </p>

    <ul class="no-bullet margin-bottom-0">
      <% @proposal.proposal_matches.fulfilled.each do |match| %>
        <li class="margin-bottom-s">
          <p class="small margin-bottom-0">
            <strong><%= match.offer.title %></strong>
          </p>
          <div class="help-text margin-top-0">
            <%= t("proposals.show.supported_by", default: "Supported by") %> <%= match.offer.author.name %>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
<% end %>
