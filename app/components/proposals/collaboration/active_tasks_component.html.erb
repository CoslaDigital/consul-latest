<div class="active-tasks-container margin-bottom">
  <% if author? %>
    <%# AUTHOR VIEW %>
    <% if @proposal.proposal_matches.confirmed.any? || @proposal.proposal_matches.accepted.any? %>
      <div class="callout primary margin-bottom-0">
        <p>
          <i class="fa fa-tasks" aria-hidden="true"></i>
          <strong><%= t("proposals.show.collaboration_actions") %></strong>
        </p>

        <% @proposal.proposal_matches.accepted.each do |match| %>
          <div class="text-center margin-bottom-s">
            <p class="small margin-bottom-s">
              <%= t("proposals.show.finalize_author_action", name: match.offer.author.name) %>
            </p>
            <%= render Admin::TableActionsComponent.new(match, actions: [:confirm], confirm_path: confirm_proposal_match_path(match)) %>
          </div>
        <% end %>

        <% @proposal.proposal_matches.confirmed.each do |match| %>
          <div class="text-center margin-top-s">
            <p class="small margin-bottom-s">
              <%= t("proposals.show.active_author_action", name: match.offer.author.name) %>
            </p>
            <%= render Admin::TableActionsComponent.new(match, actions: [:fulfill], fulfill_path: fulfill_proposal_match_path(match)) %>
          </div>
        <% end %>
      </div>
    <% end %>

  <% else %>
    <%# VISITOR VIEW %>
    <% if @proposal.proposal_matches.accepted.any? || @proposal.proposal_matches.confirmed.any? %>
      <div class="collaboration-ongoing margin-bottom-0">
        <%# Changed from sidebar-title to standard bold %>
        <p class="margin-bottom-s">
          <i class="fa fa-refresh text-warning" aria-hidden="true"></i>
          <strong><%= t("proposals.show.active_collabs") %></strong>
        </p>

        <ul class="no-bullet margin-bottom-0">
          <% @proposal.proposal_matches.accepted.each do |match| %>
            <li class="margin-bottom-s">
              <p class="small margin-bottom-0">
                <i class="fa fa-hourglass-half text-warning" aria-hidden="true"></i>
                <%= t("proposals.show.finalizing_with") %> <strong><%= match.offer.author.name %></strong>
              </p>
              <div class="help-text margin-top-0"><%= match.offer.title %></div>
            </li>
          <% end %>

          <% @proposal.proposal_matches.confirmed.each do |match| %>
            <li class="margin-bottom-s">
              <p class="small margin-bottom-0">
                <i class="fa fa-check-square text-success" aria-hidden="true"></i>
                <strong><%= match.offer.author.name %></strong> <%= t("proposals.show.is_supporting") %>
              </p>
              <div class="help-text margin-top-0"><%= match.offer.title %></div>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>
</div>
