<div class="sidebar-divider"></div>
<h2 class="sidebar-title"><%= t("shared.tags_cloud.categories") %></h2>
<br>

<ul id="categories" class="no-bullet categories">

  <%# 1. Explicit escape hatch to clear the category %>
  <li class="inline-block">
    <%= link_to t("proposals.index.all_categories", default: "All Categories"),
                proposals_path(project: current_project, search: nil),
                class: ("is-active" if current_search.blank?) %>
  </li>

  <% categories.each do |category| %>
    <li class="inline-block">
      <% if active?(category) %>
        <%# 2. If already active, clicking it again toggles it OFF %>
        <%= link_to category.name,
                    proposals_path(project: current_project, search: nil),
                    class: "is-active" %>
      <% else %>
        <%# 3. If inactive, clicking it turns it ON %>
        <%= link_to category.name,
                    proposals_path(search: category.name, project: current_project) %>
      <% end %>
    </li>
  <% end %>
</ul>
