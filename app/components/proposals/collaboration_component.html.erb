<div class="collaboration-status-sidebar">
  <%# Main heavy divider and title %>
  <div class="sidebar-divider"></div>
  <h2 class="sidebar-title"><%= t("proposals.show.collaboration_status", default: "Mutual Aid Status") %></h2>

  <div class="margin-bottom">
    <%# --- EMPTY STATE LOGIC --- %>
    <% has_history = @proposal.proposal_matches.fulfilled.any? %>
    <% has_active = @proposal.proposal_matches.accepted.any? || @proposal.proposal_matches.confirmed.any? %>

    <% if !has_history && !has_active %>
      <p class="help-text margin-bottom">
        <%= t("proposals.show.no_collaborations", default: "There are no active collaborations for this project yet.") %>
      </p>
    <% end %>

    <%# --- SUB-COMPONENTS --- %>
    <%= render Proposals::Collaboration::HistoryComponent.new(@proposal) %>
    <%= render Proposals::Collaboration::ActiveTasksComponent.new(@proposal, @current_user) %>

    <%# Subtle separator before the call-to-action %>
    <hr class="margin-top-s margin-bottom-s">

    <%= render Proposals::Collaboration::VisitorActionComponent.new(@proposal, @current_user) %>
  </div>
</div>
