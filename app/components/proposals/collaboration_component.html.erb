<div class="collaboration-status-sidebar">
  <%# 1. Standard CONSUL top divider (matches the social share and votes divider) %>
  <div class="sidebar-divider"></div>

  <%# 2. Standard CONSUL sidebar heading %>
  <h2 class="sidebar-title"><%= t("proposals.show.collaboration_status", default: "Mutual Aid Status") %></h2>

  <div class="margin-bottom">
    <%# 3. Success History (Static List) %>
    <%= render Proposals::Collaboration::HistoryComponent.new(@proposal) %>

    <%# 4. Active Tasks (Author vs Visitor logic) %>
    <%= render Proposals::Collaboration::ActiveTasksComponent.new(@proposal, @current_user) %>

    <%# 5. Visitor Action (The form or the status badge) %>
    <%= render Proposals::Collaboration::VisitorActionComponent.new(@proposal, @current_user) %>
  </div>
</div>
