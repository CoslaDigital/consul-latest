<div class="sidebar-divider"></div>
<h2 class="sidebar-title"><%= t("proposals.index.project_kinds", default: "Project Types") %></h2>
<br>

<ul id="proposal-kinds" class="no-bullet categories">
  <li class="inline-block">
    <%# Wipes the search param to ensure categories reset %>
    <%= link_to t("proposals.index.all_types", default: "All Types"),
                proposals_path(project: nil),
                class: ("is-active" if all_types_active?) %>
  </li>

  <% kinds.each do |kind| %>
    <li class="inline-block">
      <%# Wipes the search param to ensure categories reset %>
      <%= link_to kind.name,
                  proposals_path(project: kind.slug),
                  class: ("is-active" if active?(kind)) %>
    </li>
  <% end %>
</ul>
